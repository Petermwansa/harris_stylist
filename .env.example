# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git — it must NEVER be committed or shared.

# ---- Firebase (server-only secrets — no NEXT_PUBLIC_ prefix!) -------------
# Firebase console → ⚙ Project settings → Service accounts →
# "Generate new private key". Copy these three values from the JSON file:
FIREBASE_PROJECT_ID=harris-stylist
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@harris-stylist.iam.gserviceaccount.com
# Keep the quotes and the \n characters exactly as they are in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----••••••••••••••••••••-----END PRIVATE KEY-----\n"

# Firebase console → Storage (only needed once you upload photos)
FIREBASE_STORAGE_BUCKET=harris-stylist.firebasestorage.app

# ---- Admin panel: who may sign in -------------------------------------------
# Comma-separated list of emails allowed into /admin (server-only).
ADMIN_EMAILS=harris@example.com

# ---- Admin panel: browser sign-in (public by design, safe to expose) -------
# Firebase console → ⚙ Project settings → General → "Your apps" → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=harris-stylist.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=harris-stylist

# ---- Local testing with the Firebase Emulator (optional) -------------------
# Uncomment these lines to use the local emulators (npm run emulators)
# instead of the real database and real logins. No keys needed when set.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ---- Public settings -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000





# Who may sign in to /admin (comma-separated if more than one)
ADMIN_EMAILS=harris.real.email@gmail.com

# Public sign-in settings from Project settings → Your apps (safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...your key...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=harris-stylist.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=harris-stylist