rules_version = '2';

// These rules control what BROWSERS (and anyone on the internet) may do
// directly with the database. Our website never talks to Firestore from the
// browser — every read and write goes through the Next.js server using the
// Admin SDK, which is trusted and skips these rules.
//
// So the safest rule is the simplest: nobody gets direct access.
// Bookings, messages and emails are private to Harris.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}